<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>

    <AssemblyName>ZeroDash</AssemblyName>
    <RootNamespace>ZeroDash</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>zerodash.ico</ApplicationIcon>

    <!-- Versão única do projeto (SemVer). Atualize aqui e no CHANGELOG.md a cada release. -->
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <Product>ZeroDash</Product>
    <Description>Dashboard de hardware para o minimonitor ZeroMOD 1920x480</Description>
    <Copyright>Copyright (c) 2026 ZeroDash contributors</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <EmbeddedResource Include="skins\*.html" LogicalName="skin.%(Filename)" />
    <EmbeddedResource Include="zerodash.ico" LogicalName="zerodash.ico" />
  </ItemGroup>
</Project>
